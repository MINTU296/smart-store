# Apex Retail Store Intelligence — environment configuration
# Copy to .env and adjust as needed.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
API_CONFIDENCE_FLOOR=0.4

# --- Storage ---
SQLITE_PATH=/data/store_intelligence.db
REDIS_URL=redis://redis:6379/0

# --- Pipeline ---
PIPELINE_API_BASE=http://api:8000
PIPELINE_BATCH_SIZE=200
PIPELINE_FPS=15
PIPELINE_REID_THRESHOLD=0.75
PIPELINE_REENTRY_WINDOW_SEC=1800
PIPELINE_DWELL_EMIT_SEC=30

# --- POS correlation ---
POS_CSV_PATH=/data/POS - sample transactionsb1e826f.csv
POS_CORRELATION_WINDOW_SEC=300
# The shipped CSV uses "ST1008" and a fixed 10-04-2026 date. These two
# vars rewrite each row at load time so the rows correlate with events
# from the pipeline (which use STORE_BLR_001 anchored at 2026-03-08).
# Leave both blank in production where the CSV already uses canonical keys.
POS_STORE_ID_MAP={"ST1008":"STORE_BLR_001"}
POS_DATE_REMAP_TO=2026-03-08

# --- Anomaly thresholds ---
QUEUE_SPIKE_DEPTH=5
DEAD_ZONE_MINUTES=30
STALE_FEED_MINUTES=10
