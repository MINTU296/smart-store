# Apex Retail Store Intelligence — environment configuration
# Copy to .env and adjust as needed.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
API_CONFIDENCE_FLOOR=0.4

# --- Storage ---
SQLITE_PATH=/data/store_intelligence.db
REDIS_URL=redis://redis:6379/0

# --- Pipeline ---
PIPELINE_API_BASE=http://api:8000
PIPELINE_BATCH_SIZE=200
PIPELINE_FPS=15
PIPELINE_REID_THRESHOLD=0.75
PIPELINE_REENTRY_WINDOW_SEC=1800
PIPELINE_DWELL_EMIT_SEC=30

# --- POS correlation ---
POS_CSV_PATH=/data/POS - sample transactionsb1e826f.csv
POS_CORRELATION_WINDOW_SEC=300

# --- POS demo-only translations ---
# The shipped sample CSV uses "ST1008" and a fixed 10-04-2026 date. The three
# vars below rewrite each row at load time so the rows correlate with events
# from the pipeline (which uses STORE_BLR_001 / STORE_BLR_002 anchored at
# 2026-03-08). Set all three to blank in production where the CSV already
# uses canonical keys; see docs/CHOICES.md "POS demo translations".
POS_STORE_ID_MAP={"ST1008":"STORE_BLR_001"}
POS_DATE_REMAP_TO=2026-03-08
# Round-robin POS rows across both demo stores by order_id parity, so
# /metrics for STORE_BLR_002 isn't permanently 0% conversion just because
# the supplied CSV only ships ST1008 rows. Empty list = no split.
POS_SPLIT_ACROSS_STORES=["STORE_BLR_001","STORE_BLR_002"]

# --- Anomaly thresholds ---
QUEUE_SPIKE_DEPTH=5
DEAD_ZONE_MINUTES=30
STALE_FEED_MINUTES=10
